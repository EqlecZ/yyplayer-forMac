// Monochrome art is tinted by the active accent in the page, including system color changes.
export global BackgroundArt {
    out property <image> library-orbits: @image-url("assets/backgrounds/library-orbits.svg");
    out property <image> library-ribbons: @image-url("assets/backgrounds/library-ribbons.svg");
    out property <image> library-horizon: @image-url("assets/backgrounds/library-horizon.svg");
    out property <image> library-grid: @image-url("assets/backgrounds/library-grid.svg");
    out property <image> lyrics-halo: @image-url("assets/backgrounds/lyrics-halo.svg");
    out property <image> lyrics-staff: @image-url("assets/backgrounds/lyrics-staff.svg");
    out property <image> lyrics-veil: @image-url("assets/backgrounds/lyrics-veil.svg");
    out property <image> lyrics-stars: @image-url("assets/backgrounds/lyrics-stars.svg");
}
