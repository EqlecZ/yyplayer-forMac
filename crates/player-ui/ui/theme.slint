// Semantic tokens: add a design profile here without coupling pages to IDs or OS APIs.
export global Theme {
    in property <bool> dark: true;
    in property <int> design: 1;
    in property <bool> reduced-motion;
    in property <color> accent: #6875e8;
    in property <color> accent-ink: white;
    in property <color> accent-text: #9fa8ff;
    in property <float> lyrics-mix;
    in property <color> lyrics-color: #6875e8;
    out property <bool> fashion: self.design == 1;
    out property <duration> fast: self.reduced-motion ? 0ms : 140ms;
    out property <duration> smooth: self.reduced-motion ? 0ms : 260ms;
    out property <length> radius: self.fashion ? 18px : 8px;
    out property <color> base-background: self.dark ? (self.fashion ? #10131b : #111519) : #f2f4fa;
    out property <color> lyrics-base: (self.dark ? #11151b : #f4f4f1).mix(self.lyrics-color, self.dark ? 0.83 : 0.88);
    out property <color> background: self.base-background.mix(self.lyrics-base, 1 - self.lyrics-mix);
    out property <color> sidebar: (self.dark ? (self.fashion ? #191d28 : #151a1e) : #ffffff).mix(self.lyrics-base.mix(self.lyrics-color, 0.93), 1 - self.lyrics-mix);
    out property <color> surface: (self.dark ? (self.fashion ? #222735 : #1b2227) : #ffffff).mix((self.dark ? #222735 : #ffffff).mix(self.lyrics-color, 0.86), 1 - self.lyrics-mix);
    out property <color> raised: (self.dark ? (self.fashion ? #303749 : #232c31) : #e9edf6).mix((self.dark ? #303749 : #e9edf6).mix(self.lyrics-color, 0.78), 1 - self.lyrics-mix);
    out property <color> border: (self.dark ? (self.fashion ? #3c455b : #2b3439) : #dce1ed).mix((self.dark ? #3c455b : #dce1ed).mix(self.lyrics-color, 0.7), 1 - self.lyrics-mix);
    out property <color> text: self.dark ? #f0f2f8 : #1d2234;
    out property <color> muted: self.dark ? #acb5cb : #59657c;
    out property <color> faint: self.dark ? #8390aa : #64718a;
    out property <color> control-icon: self.muted.mix(self.accent-text, 1 - self.lyrics-mix * 0.85);
    out property <color> selected: self.accent.with-alpha(self.dark ? 0.19 : 0.12);
    out property <color> glass: self.fashion ? self.sidebar.with-alpha(self.dark ? 0.85 : 0.88) : self.sidebar;
    out property <color> rim: self.dark ? #ffffff24 : #ffffffd9;
    out property <color> shadow: self.dark ? #00000070 : #33456b22;
    out property <color> glow: self.accent.with-alpha(self.dark ? 0.10 : 0.08);
}

// Alias inputs accept bindings at the instance, keeping globals reactive.
export component ThemeBinding inherits Rectangle {
    in property <color> accent <=> Theme.accent;
    in property <color> ink <=> Theme.accent-ink;
    in property <color> text-accent <=> Theme.accent-text;
    in property <color> album <=> Theme.lyrics-color;
    in property <float> mix <=> Theme.lyrics-mix;
    width: 0px; height: 0px;
}

export global Icons {
    out property <image> close: @image-url("assets/icons/close.svg");
    out property <image> minus: @image-url("assets/icons/minus.svg");
    out property <image> maximize: @image-url("assets/icons/maximize.svg");
    out property <image> restore: @image-url("assets/icons/restore.svg");
    out property <image> brand: @image-url("../../../assets/icons/yyplayer/liquid-orbit-disc/yyplayer-256.png");
    out property <image> music: @image-url("assets/icons/music.svg");
    out property <image> video: @image-url("assets/icons/video.svg");
    out property <image> clock: @image-url("assets/icons/clock.svg");
    out property <image> settings: @image-url("assets/icons/settings.svg");
    out property <image> search: @image-url("assets/icons/search.svg");
    out property <image> plus: @image-url("assets/icons/plus.svg");
    out property <image> folder: @image-url("assets/icons/folder.svg");
    out property <image> play: @image-url("assets/icons/play.svg");
    out property <image> pause: @image-url("assets/icons/pause.svg");
    out property <image> seek-back: @image-url("assets/icons/seek-back.svg");
    out property <image> seek-forward: @image-url("assets/icons/seek-forward.svg");
    out property <image> previous: @image-url("assets/icons/previous.svg");
    out property <image> next: @image-url("assets/icons/next.svg");
    out property <image> heart: @image-url("assets/icons/heart.svg");
    out property <image> volume: @image-url("assets/icons/volume.svg");
    out property <image> arrow: @image-url("assets/icons/arrow.svg");
    out property <image> chevron-down: @image-url("assets/icons/chevron-down.svg");
    out property <image> chevron-up: @image-url("assets/icons/chevron-up.svg");
    out property <image> checkmark: @image-url("assets/icons/checkmark.svg");
    out property <image> shuffle: @image-url("assets/icons/shuffle.svg");
    out property <image> repeat: @image-url("assets/icons/repeat.svg");
    out property <image> grid: @image-url("assets/icons/grid.svg");
    out property <image> headphones: @image-url("assets/icons/headphones.svg");
    out property <image> sliders: @image-url("assets/icons/sliders.svg");
    out property <image> more: @image-url("assets/icons/more.svg");
}

export global Artwork {
    out property <image> night: @image-url("assets/artwork/night.svg");
    out property <image> water: @image-url("assets/artwork/water.svg");
    out property <image> sun: @image-url("assets/artwork/sun.svg");
    out property <image> cinema: @image-url("assets/artwork/cinema.svg");
