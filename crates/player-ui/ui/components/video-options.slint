import { ScrollView } from "std-widgets.slint";
import { ThemeComboBox as ComboBox, ThemeSpinBox as SpinBox, ThemeCheckBox as CheckBox, ThemeButton as Button, ThemeLineEdit as LineEdit } from "theme-widgets.slint";
import { Theme } from "../theme.slint";
import { TrackRow } from "../models.slint";
import { QueueRow } from "media.slint";
import { AudioOptions } from "audio-options.slint";
import { AudioForm } from "../models.slint";
export component VideoOptions inherits Rectangle {
    in property <bool> video; in property <AudioForm> audio-form;
    in property <string> audio-status; in property <string> eq-origin; in property <string> eq-binding; in property <string> eq-headroom-text;
    in property <[string]> devices; in property <int> device-index;
    in property <[string]> audio-tracks; in property <int> audio-index;
    in property <[string]> subtitle-tracks; in property <int> subtitle-index;
    in property <[string]> chapters; in property <string> info;
    in property <int> decode-mode; in property <int> decode-threads; in property <int> decode-scope;
    in property <bool> deinterlace; in property <bool> deband; in property <string> decode-origin;
    in property <[TrackRow]> queue; in property <int> selected-id;
    private property <bool> info-open;
    callback control(string,string);
    background: Theme.glass;
    private property <float> entrance: 0; init => { root.entrance = 1; }
    opacity: root.entrance; animate entrance { duration: Theme.smooth; easing: ease-out; }
    ScrollView {
        width: parent.width; height: parent.height; viewport-width: self.width;
        VerticalLayout {
            padding: 20px; spacing: 12px;
            HorizontalLayout { height: 30px; Text { text: "播放选项"; color: Theme.text; font-size: 18px; font-weight: 600; horizontal-stretch: 1; } Button { text: "关闭"; clicked => { root.control("panel", ""); } } }
            Button { text: "停止播放"; clicked => { root.control("stop", ""); } }
            Text { text: "音频输出设备"; color: Theme.muted; height: 20px; }
            ComboBox { model: root.devices; current-index: root.device-index; selected(value, choice) => { root.control("device", "" + choice); } }
            Button { text: root.info-open ? "收起媒体信息" : "查看媒体 / 音频输出信息"; clicked => { root.info-open = !root.info-open; } }
            if root.info-open: Rectangle { height: 400px; background: Theme.surface; border-radius: 6px;
                ScrollView { x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px; viewport-width: self.width;
                    TextInput { text: root.info; read-only: true; width: parent.width; height: max(384px, self.preferred-height); font-size: 11px; color: Theme.text; wrap: word-wrap; selection-background-color: Theme.selected; selection-foreground-color: Theme.text; }
                }
            }
            AudioOptions { form: root.audio-form; status: root.audio-status; origin: root.eq-origin; binding: root.eq-binding; headroom: root.eq-headroom-text; control(action,value) => { root.control(action,value); } }
            HorizontalLayout { CheckBox { controlled: false; text: "单文件循环"; toggled(next) => { root.control("loop", next ? "yes" : "no"); } } Button { text: "A / B / 清除"; clicked => { root.control("ab-loop", ""); } } }
            if root.video: VerticalLayout {
            Text { text: "音轨 / 字幕"; color: Theme.muted; height: 20px; }
            ComboBox { model: root.audio-tracks; current-index: root.audio-index; selected(value, choice) => { root.control("audio-track", "" + choice); } }
            ComboBox { model: root.subtitle-tracks; current-index: root.subtitle-index; selected(value, choice) => { root.control("subtitle-track", "" + choice); } }
            Button { text: "加载外挂字幕"; clicked => { root.control("subtitle-file", ""); } }
            HorizontalLayout { Text { text: "字幕延迟（秒）"; color: Theme.muted; vertical-alignment: center; } LineEdit { text: "0"; edited(value) => { root.control("subtitle-delay", value); } } }
            HorizontalLayout { Text { text: "音频延迟（秒）"; color: Theme.muted; vertical-alignment: center; } LineEdit { text: "0"; edited(value) => { root.control("audio-delay", value); } } }
            ComboBox { controlled: false; model: root.chapters; current-index: -1; selected(value, choice) => { root.control("chapter", "" + choice); } }
            HorizontalLayout { Button { text: "上一帧"; clicked => { root.control("frame-back", ""); } } Button { text: "下一帧"; clicked => { root.control("frame", ""); } } Button { text: "截图"; clicked => { root.control("screenshot", ""); } } }
            ComboBox { controlled: false; model: ["原始比例", "16:9", "4:3", "2.35:1"]; selected(value, choice) => { root.control("aspect", "" + choice); } }
            Rectangle { height: 1px; background: Theme.border; }
            Text { text: "解码与画面"; color: Theme.text; font-size: 16px; font-weight: 600; height: 26px; }
            Text { text: "当前规则：" + root.decode-origin; color: Theme.muted; wrap: word-wrap; height: 34px; font-size: 11px; }
            scope := ComboBox { model: ["全局", "当前文件夹", "当前文件"]; current-index: root.decode-scope; selected(value, choice) => { root.control("decode-scope", "" + choice); } }
            mode := ComboBox { model: ["自动（安全硬解）", "软件解码", "硬件优先（允许 copy 回退）"]; current-index: root.decode-mode; selected(value, choice) => { root.control("decode-mode", "" + choice); } }
            HorizontalLayout { Text { text: "解码线程（0 自动）"; color: Theme.muted; vertical-alignment: center; } SpinBox { value: root.decode-threads; minimum: 0; maximum: 32; edited(value) => { root.control("decode-threads", "" + value); } } }
            CheckBox { text: "去隔行"; checked: root.deinterlace; toggled(next) => { root.control("deinterlace", next ? "yes" : "no"); } }
            CheckBox { text: "去色带"; checked: root.deband; toggled(next) => { root.control("deband", next ? "yes" : "no"); } }
            Button { text: "保存并重新加载当前媒体"; primary: true; clicked => { root.control("save-decode", ""); } }
            Button { text: "清除该范围覆盖 / 全局恢复默认"; clicked => { root.control("clear-decode", ""); } }
            Text { text: "硬解可因 codec / GPU / 驱动限制回退。\n实际运行路径见媒体信息。"; color: Theme.faint; height: 36px; font-size: 11px; }
            }
            Button { text: "编辑播放快捷键"; clicked => { root.control("settings", ""); } }
            Text { text: "当前队列"; color: Theme.text; font-size: 16px; height: 30px; }
            for track in root.queue: QueueRow { track: track; selected: root.selected-id == track.item-id; clicked => { root.control("queue", "" + track.item-id); } }
        }
    }
}
