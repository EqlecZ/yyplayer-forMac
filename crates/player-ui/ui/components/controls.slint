import { Theme } from "../theme.slint";

export component Icon inherits Rectangle {
    in property <image> icon;
    in property <color> tint: Theme.muted;
    width: 20px;
    preferred-height: self.width;
    Image {
        width: min(parent.width, parent.height);
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: root.tint;
        image-fit: contain;
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> active: false;
    callback clicked();
    width: 36px;
    height: 36px;
    border-radius: self.height / 2;
    private property <color> fill: root.primary ? Theme.accent : (touch.has-hover || focus.has-focus ? Theme.raised : transparent);
    background: root.fill; animate fill { duration: Theme.fast; easing: ease-out; }
    drop-shadow-blur: root.primary && Theme.fashion ? 10px : 0px; drop-shadow-color: Theme.accent.with-alpha(0.22);
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.accent-text;
    accessible-role: button;
    accessible-label: root.label;
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: touch.pressed ? 17px : 20px; animate width { duration: Theme.fast; easing: ease-out; }
        icon: root.icon;
        tint: root.primary ? Theme.accent-ink : (root.active ? Theme.accent-text : Theme.control-icon);
    }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary: true;
    callback clicked();
    min-width: 122px;
    height: 38px;
    border-radius: Theme.fashion ? 19px : 8px;
    background: root.primary ? (touch.has-hover ? Theme.accent.brighter(0.1) : Theme.accent) : (touch.has-hover ? Theme.raised : transparent);
    border-width: root.primary ? 0px : 1px;
    border-color: focus.has-focus ? Theme.accent : Theme.border;
    accessible-role: button;
    accessible-label: root.text;
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        padding-left: 14px;
        padding-right: 14px;
        Icon { icon: root.icon; tint: root.primary ? Theme.accent-ink : Theme.text; width: 16px; }
        Text { text: root.text; color: root.primary ? Theme.accent-ink : Theme.text; font-size: 12px; font-weight: 600; vertical-alignment: center; }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

export component NavItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    callback clicked();
    height: 44px;
    border-radius: Theme.fashion ? 19px : 8px;
    private property <color> fill: root.selected ? Theme.selected : (touch.has-hover ? Theme.surface : transparent);
    background: root.fill; animate fill { duration: Theme.fast; }
    border-width: root.selected && Theme.fashion ? 1px : 0px; border-color: Theme.accent.with-alpha(0.24);
    accessible-role: button;
    accessible-label: root.text;
    HorizontalLayout {
        padding-left: touch.pressed ? 16px : 14px; animate padding-left { duration: Theme.fast; }
        padding-right: 14px;
        spacing: 12px;
        Icon { icon: root.icon; tint: root.selected ? Theme.accent-text : Theme.muted; width: 18px; }
        Text { text: root.text; color: root.selected ? Theme.accent-text : Theme.muted; font-size: 13px; font-weight: root.selected ? 600 : 400; vertical-alignment: center; horizontal-stretch: 1; }
        if root.selected: Rectangle { width: 4px; height: 4px; y: (parent.height - self.height) / 2; border-radius: 2px; background: Theme.accent; }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <bool> accented: false;
    height: 22px;
    width: label.preferred-width + 16px;
    border-radius: 5px;
    background: root.accented ? Theme.selected : Theme.raised;
    label := Text {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        text: root.text;
        color: root.accented ? Theme.accent-text : Theme.muted;
        font-size: 10px;
        vertical-alignment: center;
    }
}

export component QuietSlider inherits Rectangle {
    in property <float> value;
    in property <bool> enabled: true;
    in property <string> label;
    callback edited(float);
    height: 24px;
    min-width: 64px;
    accessible-role: slider;
    accessible-label: root.label;
    Rectangle { x: 0px; y: 10px; height: 4px; width: parent.width; border-radius: 2px; background: Theme.border; }
    Rectangle { x: 0px; y: 10px; height: 4px; width: max(0px, min(parent.width, parent.width * root.value / 100)); border-radius: 2px; background: root.enabled ? Theme.accent : Theme.faint; }
    if root.enabled: Rectangle { x: max(0px, min(parent.width - 10px, parent.width * root.value / 100 - 5px)); y: 7px; width: 10px; height: 10px; border-radius: 5px; background: Theme.accent; }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.LeftArrow) { root.edited(max(0, root.value - 5)); return accept; }
            if (event.text == Key.RightArrow) { root.edited(min(100, root.value + 5)); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) { focus.focus(); root.edited(max(0, min(100, self.mouse-x / root.width * 100))); }
        }
        moved => { if (self.pressed) { root.edited(max(0, min(100, self.mouse-x / root.width * 100))); } }
    }
}
