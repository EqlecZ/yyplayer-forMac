import { ThemeSpinBox as SpinBox, ThemeCheckBox as CheckBox, ThemeButton as Button } from "theme-widgets.slint";
import { Theme } from "../theme.slint";
import { LyricStyle } from "../models.slint";
import { LyricLine } from "lyric-line.slint";

component NumberOption inherits HorizontalLayout {
    in property <string> label; in property <string> unit: "px";
    in property <int> value; in property <int> minimum; in property <int> maximum;
    in property <int> step: 1;
    callback edited(int);
    out property <length> increase-x: spin.x + spin.width - 29px;
    out property <length> increase-y: spin.y + spin.height / 2;
    height: 34px; spacing: 10px;
    Text { text: root.label; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
    spin := SpinBox { width: 86px; value: root.value; minimum: root.minimum; maximum: root.maximum; step-size: root.step; edited(value) => { root.edited(value); } }
    Text { text: root.unit; width: 22px; color: Theme.faint; vertical-alignment: center; font-size: 10px; }
}

export component LyricOptions inherits Rectangle {
    in property <LyricStyle> style;
    in property <string> family;
    in property <color> accent;
    in property <bool> preview: true;
    height: form.preferred-height;
    callback control(string, string);
    callback layout(float, float, float, float);
    callback report-layout();
    report-layout => { root.layout((album-check.x + 9px) / 1px, (album-check.y + album-check.height / 2) / 1px, (gap.x + gap.increase-x) / 1px, (gap.y + gap.increase-y) / 1px); }
    init => { root.report-layout(); }
    changed width => { root.report-layout(); }
    changed height => { root.report-layout(); }
    form := VerticalLayout { spacing: 12px;
        Text { text: "主题与排版"; color: Theme.text; font-size: 19px; font-weight: 600; height: 30px; }
        album-check := CheckBox { height: 28px; text: "从专辑封面提取主题色"; checked: root.style.album-color; changed y => { root.report-layout(); } toggled(next) => { root.control("lyrics-style-album-color", next ? "yes" : "no"); } }
        CheckBox { height: 28px; text: "双语歌词上下行显示"; checked: root.style.bilingual; toggled(next) => { root.control("lyrics-style-bilingual", next ? "yes" : "no"); } }
        gap := NumberOption { label: "歌词行间距"; value: root.style.line-gap; minimum: 0; maximum: 80; changed y => { root.report-layout(); } edited(v) => { root.control("lyrics-style-line-gap", "" + v); } }
        Rectangle { height: 1px; background: Theme.border; }
        Text { text: "普通行"; color: Theme.muted; font-size: 14px; height: 20px; }
        NumberOption { label: "字号"; value: root.style.inactive-size; minimum: 12; maximum: 48; edited(v) => { root.control("lyrics-style-inactive-size", "" + v); } }
        NumberOption { label: "不透明度"; unit: "%"; value: root.style.inactive-opacity; minimum: 0; maximum: 100; edited(v) => { root.control("lyrics-style-inactive-opacity", "" + v); } }
        NumberOption { label: "字重"; unit: ""; value: root.style.inactive-weight; minimum: 100; maximum: 900; step: 100; edited(v) => { root.control("lyrics-style-inactive-weight", "" + v); } }
        Rectangle { height: 1px; background: Theme.border; }
        Text { text: "当前行"; color: Theme.muted; font-size: 14px; height: 20px; }
        NumberOption { label: "字号"; value: root.style.active-size; minimum: 12; maximum: 64; edited(v) => { root.control("lyrics-style-active-size", "" + v); } }
        NumberOption { label: "字重"; unit: ""; value: root.style.active-weight; minimum: 100; maximum: 900; step: 100; edited(v) => { root.control("lyrics-style-active-weight", "" + v); } }
        Rectangle { height: 1px; background: Theme.border; }
        Text { text: "副语言"; color: Theme.muted; font-size: 14px; height: 20px; }
        NumberOption { label: "字重"; unit: ""; value: root.style.secondary-weight; minimum: 100; maximum: 900; step: 100; edited(v) => { root.control("lyrics-style-secondary-weight", "" + v); } }
        NumberOption { label: "两种语言间距"; value: root.style.bilingual-gap; minimum: 0; maximum: 40; edited(v) => { root.control("lyrics-style-bilingual-gap", "" + v); } }
        if root.preview: Rectangle {
            background: Theme.background; border-radius: 12px;
            height: sample.height + 20px;
            sample := LyricLine { x: 10px; y: 10px; width: parent.width - 20px; line: {text: "Listen to the evening / 听见晚风", primary: "Listen to the evening", secondary: "听见晚风", milliseconds: -1}; style: root.style; family: root.family; accent: root.accent; active: true; }
        }
        Text { text: "即时生效并自动保存。双语以空格斜线「 / 」分隔，副语言字号随主语言缩放。"; color: Theme.faint; wrap: word-wrap; height: 42px; font-size: 13px; }
        Button { text: "恢复歌词页默认设置"; height: 34px; clicked => { root.control("lyrics-style-reset", ""); } }
    }
}
