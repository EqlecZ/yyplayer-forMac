import { Theme, Artwork, Icons } from "../theme.slint";
import { Icon, IconButton } from "controls.slint";
import { TrackRow } from "../models.slint";

export component Cover inherits Image {
    in property <int> artwork-id;
    in property <image> artwork;
    source: root.artwork.width > 0 ? root.artwork : root.artwork-id < 0 ? Icons.music : root.artwork-id == 1 ? Artwork.water : (root.artwork-id == 2 ? Artwork.sun : Artwork.night);
    image-fit: root.artwork.width > 0 ? cover : contain;
    colorize: root.artwork.width == 0 && root.artwork-id < 0 ? Theme.muted : transparent;
}

export component AlbumCard inherits Rectangle {
    in property <int> artwork-id;
    in property <image> artwork;
    in property <string> title;
    in property <string> subtitle;
    callback clicked();
    height: root.width + 62px;
    background: transparent;
    accessible-role: button;
    accessible-label: root.title;
    VerticalLayout {
        spacing: 8px;
        Cover { artwork-id: root.artwork-id; height: self.width; horizontal-stretch: 1; }
        Text { text: root.title; color: Theme.text; font-size: 13px; font-weight: 600; height: 18px; overflow: elide; }
        Text { text: root.subtitle; color: Theme.muted; font-size: 11px; height: 18px; overflow: elide; }
        Rectangle { height: 2px; }
    }
    if touch.has-hover: Rectangle {
        width: 32px;
        height: 32px;
        x: parent.width - 42px;
        y: parent.width - 42px;
        border-radius: 16px;
        background: Theme.accent;
        Icon { icon: Icons.arrow; tint: Theme.accent-ink; x: 7px; y: 7px; width: 18px; height: 18px; }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

export component SongRow inherits Rectangle {
    in property <TrackRow> track; in property <int> number; in property <bool> selected;
    in property <float> column-song: 0.46; in property <float> column-artist: 0.24;
    private property <length> prefix: root.width < 520px ? 38px : 88px;
    private property <length> columns: max(1px, root.width - root.prefix - 58px);
    callback clicked();
    height: 52px; border-radius: 7px;
    private property <color> fill: root.selected ? Theme.selected : (touch.has-hover ? Theme.surface : transparent);
    background: root.fill; animate fill { duration: Theme.fast; }
    accessible-role: button; accessible-label: root.track.title + "，" + root.track.artist;
    Text { x: 12px; width: 20px; height: parent.height; text: root.number < 10 ? "0" + root.number : "" + root.number; color: Theme.faint; font-size: 13px; vertical-alignment: center; }
    if root.width >= 520px: Cover { x: 42px; y: (parent.height - 32px) / 2; artwork-id: root.track.cover; artwork: root.track.artwork; width: 32px; height: 32px; }
    Text { x: root.prefix; width: max(0px,root.columns * root.column-song - 12px); height: parent.height; text: root.track.title; color: root.selected ? Theme.accent-text : Theme.text; font-size: 14px; vertical-alignment: center; overflow: elide; }
    Text { x: root.prefix + root.columns * root.column-song + 6px; width: max(0px,root.columns * root.column-artist - 12px); height: parent.height; text: root.track.artist; color: Theme.muted; font-size: 13px; vertical-alignment: center; overflow: elide; }
    Text { x: root.prefix + root.columns * (root.column-song + root.column-artist) + 6px; width: max(0px,root.columns * (1 - root.column-song - root.column-artist) - 12px); height: parent.height; text: root.track.collection; color: Theme.muted; font-size: 13px; vertical-alignment: center; overflow: elide; }
    Text { x: parent.width - 52px; width: 40px; height: parent.height; text: root.track.duration; color: Theme.faint; font-size: 14px; vertical-alignment: center; horizontal-alignment: center; overflow: elide; }
    focus := FocusScope { key-pressed(event) => { if event.text == " " || event.text == "\n" { root.clicked(); return accept; } return reject; } }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

export component QueueRow inherits Rectangle {
    in property <TrackRow> track;
    in property <bool> selected;
    callback clicked();
    height: 68px;
    border-radius: 8px;
    background: root.selected ? Theme.selected : (touch.has-hover ? Theme.raised : transparent);
    accessible-role: button;
    accessible-label: root.track.title;
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        Cover { artwork-id: root.track.cover; width: 42px; height: 42px; }
        VerticalLayout {
            alignment: center;
            spacing: 5px;
            horizontal-stretch: 1;
            Text { text: root.track.title; color: root.selected ? Theme.accent-text : Theme.text; font-size: 11px; overflow: elide; }
            Text { text: root.track.artist; color: Theme.muted; font-size: 9px; overflow: elide; }
        }
        Text { text: root.track.duration; color: Theme.faint; font-size: 9px; vertical-alignment: center; }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}
