import { ScrollView } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { Icon } from "controls.slint";

// Standard Palette colors are read-only in Slint 1.17.1. Playback widgets
// consume our semantic Theme directly, including popup and focus colors.
export component ThemeButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    preferred-width: label.preferred-width + 28px; min-width: 28px; min-height: 32px; preferred-height: 34px;
    horizontal-stretch: 0; vertical-stretch: 0;
    border-radius: 7px; border-width: 1px;
    border-color: focus.has-focus ? Theme.accent-text : (root.primary ? transparent : Theme.border);
    background: root.primary ? Theme.accent : (touch.has-hover ? Theme.raised : Theme.surface);
    opacity: root.enabled ? 1 : 0.45;
    forward-focus: focus; accessible-enabled: root.enabled;
    accessible-role: button; accessible-label: root.text;
    label := Text { x: min(12px, parent.width * 0.2); width: parent.width - self.x * 2; height: parent.height; text: root.text; color: root.primary ? Theme.accent-ink : Theme.text; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if event.text == " " || event.text == "\n" { root.clicked(); return accept; } return reject; } }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
}

export component ThemeCheckBox inherits Rectangle {
    in property <bool> checked;
    in property <bool> controlled: true;
    private property <bool> local-checked: root.checked;
    out property <bool> checked-state: root.controlled ? root.checked : root.local-checked;
    in property <string> text;
    in property <bool> enabled: true;
    callback toggled(bool);
    min-height: 28px; preferred-height: 28px; min-width: label.preferred-width + 30px;
    accessible-role: checkbox; accessible-label: root.text;
    forward-focus: focus; accessible-enabled: root.enabled;
    accessible-checkable: true; accessible-checked: root.checked-state;
    function toggle() { if root.enabled { let next = !root.checked-state; if !root.controlled { root.local-checked = next; } root.toggled(next); } }
    accessible-action-default => { root.toggle(); }
    Rectangle { x: 0px; y: (parent.height - 18px) / 2; width: 18px; height: 18px; border-radius: 4px;
        background: root.checked-state ? Theme.accent : (touch.has-hover ? Theme.raised : Theme.surface);
        border-width: root.checked-state && !focus.has-focus ? 0px : 1px; border-color: focus.has-focus ? Theme.accent-text : Theme.border;
        Icon { x: 2px; y: 2px; width: 14px; height: 14px; visible: root.checked-state; icon: Icons.checkmark; tint: Theme.accent-ink; }
    }
    label := Text { x: 28px; width: parent.width - 28px; height: parent.height; text: root.text; color: Theme.text; vertical-alignment: center; overflow: elide; }
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => { if event.text == " " || event.text == "\n" { root.toggle(); return accept; } return reject; } }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.toggle(); } }
}

export component ThemeSpinBox inherits Rectangle {
    in property <int> value;
    in property <int> minimum; in property <int> maximum: 100; in property <int> step-size: 1;
    in property <bool> enabled: true;
    callback edited(int);
    min-height: 34px; preferred-height: 34px; min-width: 76px; preferred-width: 90px;
    background: Theme.surface; border-radius: 6px; border-width: 1px;
    border-color: entry.has-focus ? Theme.accent-text : Theme.border;
    accessible-role: spinbox; accessible-value: "" + root.value;
    forward-focus: entry; accessible-enabled: root.enabled;
    accessible-value-minimum: root.minimum; accessible-value-maximum: root.maximum;
    function update(next: int) { let bounded = min(root.maximum, max(root.minimum, next)); let v = min(root.maximum, max(root.minimum, root.minimum + round((bounded - root.minimum) / max(1, root.step-size)) * root.step-size)); if v != root.value { root.edited(v); } }
    function commit() { if entry.text.is-float() { root.update(round(entry.text.to-float())); } entry.text = "" + root.value; }
    accessible-action-increment => { root.update(root.value + root.step-size); }
    accessible-action-decrement => { root.update(root.value - root.step-size); }
    accessible-action-set-value(v) => { if v.is-float() { root.update(round(v.to-float())); } }
    changed value => { if !entry.has-focus { entry.text = "" + root.value; } }
    entry := TextInput {
        x: 8px; y: 0px; width: parent.width - 46px; height: parent.height;
        text: "" + root.value; color: Theme.text; single-line: true; input-type: number; enabled: root.enabled;
        selection-background-color: Theme.selected; selection-foreground-color: Theme.text;
        vertical-alignment: center;
        accepted => { root.commit(); }
        changed has-focus => { if !self.has-focus { root.commit(); } }
        key-pressed(event) => {
            if event.text == Key.UpArrow { root.update(root.value + root.step-size); return accept; }
            if event.text == Key.DownArrow { root.update(root.value - root.step-size); return accept; }
            return reject;
        }
    }
    Rectangle { x: parent.width - 38px; width: 18px; height: parent.height; background: up.has-hover ? Theme.raised : transparent;
        Icon { x: 3px; y: (parent.height - 12px) / 2; width: 12px; height: 12px; icon: Icons.chevron-up; tint: Theme.accent-text; }
        up := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.update(root.value + root.step-size); } }
    }
    Rectangle { x: parent.width - 20px; width: 18px; height: parent.height; background: down.has-hover ? Theme.raised : transparent;
        Icon { x: 3px; y: (parent.height - 12px) / 2; width: 12px; height: 12px; icon: Icons.chevron-down; tint: Theme.accent-text; }
        down := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.update(root.value - root.step-size); } }
    }
}

export component ThemeComboBox inherits Rectangle {
    in property <[string]> model;
    in property <int> current-index;
    in property <bool> controlled: true;
    private property <int> local-index: root.current-index;
    out property <int> display-index: root.controlled ? root.current-index : root.local-index;
    in property <bool> enabled: true;
    in property <bool> above;
    callback selected(string, int);
    out property <bool> input-focused: focus.has-focus || popup.is-open;
    out property <string> current-text: root.model[root.display-index];
    min-height: 34px; preferred-height: 34px; min-width: 70px;
    background: touch.has-hover ? Theme.raised : Theme.surface; border-radius: 6px; border-width: 1px;
    border-color: focus.has-focus || popup.is-open ? Theme.accent-text : Theme.border;
    accessible-role: combobox; accessible-label: label.text;
    forward-focus: focus; accessible-enabled: root.enabled;
    function choose(index: int) { if index >= 0 && index < root.model.length { if !root.controlled { root.local-index = index; } root.selected(root.model[index], index); } }
    label := Text { x: 10px; width: parent.width - 32px; height: parent.height; text: root.current-text; color: Theme.text; vertical-alignment: center; overflow: elide; }
    Icon { x: parent.width - 23px; y: (parent.height - 14px) / 2; width: 14px; height: 14px; icon: Icons.chevron-down; tint: Theme.accent-text; }
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => {
        if event.text == Key.UpArrow { root.choose(max(0, root.display-index - 1)); return accept; }
        if event.text == Key.DownArrow { root.choose(min(root.model.length - 1, root.display-index + 1)); return accept; }
        if event.text == " " || event.text == "\n" { popup.show(); return accept; }
        if event.text == Key.Escape { popup.close(); return accept; }
        return reject;
    } }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); popup.show(); } }
    popup := PopupWindow {
        x: 0px; y: root.above ? -self.height - 4px : root.height + 4px;
        width: max(root.width, 160px); height: min(280px, root.model.length * 32px + 8px);
        Rectangle { width: parent.width; height: parent.height; background: Theme.sidebar; border-radius: 8px; border-width: 1px; border-color: Theme.border;
            ScrollView { x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px; viewport-width: self.width;
                VerticalLayout { spacing: 0px; padding: 0px;
                    for text[index] in root.model: Rectangle { height: 32px; border-radius: 4px; background: index == root.display-index ? Theme.selected : (item.has-hover ? Theme.raised : transparent);
                        Text { x: 10px; width: parent.width - 20px; height: parent.height; text: text; color: index == root.display-index ? Theme.accent-text : Theme.text; vertical-alignment: center; overflow: elide; }
                        item := TouchArea { mouse-cursor: pointer; clicked => { root.choose(index); popup.close(); } }
                    }
                }
            }
        }
    }
}

export component ThemeLineEdit inherits Rectangle {
    in property <string> text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    callback edited(string);
    forward-focus: entry;
    min-height: 34px; preferred-height: 34px; min-width: 32px; background: Theme.surface; border-radius: 6px; border-width: 1px;
    border-color: entry.has-focus ? Theme.accent-text : Theme.border;
    changed text => { if !entry.has-focus { entry.text = root.text; } }
    Text { x: 8px; width: parent.width - 16px; height: parent.height; text: root.placeholder-text; visible: entry.text == "" && !entry.has-focus; color: Theme.faint; vertical-alignment: center; }
    entry := TextInput { x: 8px; width: parent.width - 16px; height: parent.height; text: root.text; single-line: true; enabled: root.enabled; color: Theme.text; vertical-alignment: center; selection-background-color: Theme.selected; selection-foreground-color: Theme.text; edited => { root.edited(self.text); } }
}
