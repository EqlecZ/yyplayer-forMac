    callback apply-theme();
    apply-theme => { Theme.design = root.appearance-design; Theme.dark = root.appearance-dark; Theme.accent = root.appearance-accent; Theme.accent-ink = root.appearance-ink; Theme.accent-text = root.appearance-accent-text; Theme.reduced-motion = root.appearance-reduced || root.appearance-os-reduced; Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
