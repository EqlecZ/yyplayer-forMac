                    Rectangle { vertical-stretch: 1; }
                    Button { text: "返回上一页"; height: 34px; enabled: root.can-go-back; clicked => { root.control("page-back", ""); } }
                    NavItem { text: "设置"; icon: Icons.settings; selected: root.page == 3; clicked => { root.navigate(3); } }
                }
            }
