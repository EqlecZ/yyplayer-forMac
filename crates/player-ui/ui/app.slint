                            Text { x: 12px; width: parent.width - 24px; height: parent.height; text: root.page == 5 ? "搜索视频" : "搜索音乐"; color: Theme.faint; visible: search-input.text == "" && !search-input.has-focus; vertical-alignment: center; }
                            search-input := TextInput { x: 12px; width: parent.width - 24px; height: parent.height; text: root.search-query; single-line: true; color: Theme.text; vertical-alignment: center; accessible-label: root.page == 5 ? "搜索视频" : "搜索曲目"; changed has-focus => { root.search-focused = self.has-focus; } edited => { root.search-changed(self.text); } }
