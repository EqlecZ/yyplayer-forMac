                    NavItem { text: "视频库"; icon: Icons.video; selected: root.page == 5; clicked => { root.navigate(5); } }
                    NavItem { text: "音乐联网搜索"; icon: Icons.search; selected: root.page == 6; clicked => { root.navigate(6); } }
                    NavItem { text: "最近打开"; icon: Icons.clock; selected: root.page == 2; clicked => { root.navigate(2); } }
