                        if root.page != 0 && root.page != 5 && (root.page != 6 || !root.online-compact): VerticalLayout { width: 110px; alignment: center; Button { text: "打开文件"; clicked => { root.open-file(); } } }
                        if root.page == 1: VerticalLayout { width: 85px; alignment: center; Button { text: "媒体库"; clicked => { root.navigate(0); } } }
                        if root.page == 1: VerticalLayout { width: 110px; alignment: center; ComboBox { model: ["窗口", "最大化", "全屏"]; current-index: root.window-mode; selected(value) => { root.control("window-mode", "" + self.current-index); } } }
                        VerticalLayout { width: root.page == 6 && root.online-compact ? 72px : 100px; alignment: center; Button { text: root.page == 6 && root.online-compact ? (root.panel-open ? "关闭" : "选项") : (root.panel-open ? "关闭选项" : "播放选项"); clicked => { root.control("panel", ""); } } }
                    }
                    if root.page == 0: MusicPage { visible-first <=> root.library-visible-first; visible-count <=> root.library-visible-count; column-song <=> root.column-song; column-artist <=> root.column-artist; library-tracks: root.library-tracks; folders: root.library-folders; folder-index: root.library-folder; scanning: root.library-busy; library-selected: root.library-selected; control(action,value) => { root.control(action,value); } preview: root.preview; tracks: root.tracks; selected-id: root.selected-id; select-preview(id) => { root.select-preview(id); } select-demo-album(id) => { root.control("demo-album", "" + id); } }
                    if root.page == 4: NowPlaying { can-go-back: root.can-go-back; lyric-font: root.lyric-font; artwork: root.music-cover; title: root.selected-title; artist: root.selected-artist; album: root.album; lyrics: root.lyrics; active: root.active-lyric; plain: root.plain-lyrics; playing: root.playing; output-status: root.audio-status; background-style: root.lyrics-background-style; background-opacity: root.lyrics-background-opacity; custom-background: root.custom-lyrics-background; control(action,value) => { root.control(action,value); } }
                    if root.page == 6: OnlineSearchPage { compact: root.panel-open && root.width < 1280px; at-bottom <=> root.online-at-bottom; history-open <=> root.online-history-open; tracks: root.online-tracks; providers: root.online-providers; sources: root.online-sources; provider-index: root.online-provider; source-index: root.online-source; history: root.online-history; keep-history: root.online-keep-history; enabled: root.online-lyric-mode ? root.online-lyrics-enabled : root.online-music-enabled; busy: root.online-busy; lyric-mode: root.online-lyric-mode; message: root.online-message; selected: root.online-selected; qualities: root.online-qualities; quality-enabled: root.online-quality-enabled; download: root.online-download; download-play: root.online-download-play; visible-first <=> root.online-visible-first; visible-count <=> root.online-visible-count; control(action,value) => {root.control(action,value);} }
                    if root.page == 5: VideoLibraryPage {
