    in-out property <int> render-frames;
    in-out property <int> render-initializations;
    out property <float> video-width: root.width / 1px - (root.panel-open ? 370 : 0);
    out property <float> video-height: root.height / 1px - (root.immersive ? 0 : root.controls-height / 1px);
    out property <float> content-opacity: root.page == 1 ? 1 : root.page-arrival;
